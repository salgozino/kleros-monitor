# kleros-monitor — environment configuration
# Copy this file to .env and fill in your values.
# REQUIRED fields have no default and MUST be set or the process will refuse to start.
# SANE DEFAULT fields show the built-in default; override only when needed.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Absolute path to the kleros-monitor working directory.
# Used for state files, dossiers, and logs.
WORKDIR=                                       # REQUIRED — no default (e.g. /home/user/kleros-monitor)

# Kleros Court ID to monitor (integer).
COURT_ID=                                      # REQUIRED — no default (e.g. 34)

# Absolute path to the kleros-juror home directory containing the operator key file.
# The key file must exist at $KLEROS_JUROR_HOME/key with permissions 0600.
KLEROS_JUROR_HOME=                             # REQUIRED — no default (e.g. /home/user/.kleros-juror)

# ── SANE DEFAULTS ───────────────────────────────────────────────────────────

# Arbitrum One RPC endpoint(s) — JSON array or single URL.
# SANE DEFAULT: ["https://arb1.arbitrum.io/rpc","https://arbitrum-one-rpc.publicnode.com"]
#RPC_URLS=["https://arb1.arbitrum.io/rpc","https://arbitrum-one-rpc.publicnode.com"]

# IPFS gateways — JSON array tried in order; first responsive wins.
# SANE DEFAULT: ["https://cdn.kleros.link/ipfs/","https://ipfs.io/ipfs/","https://gateway.pinata.cloud/ipfs/"]
#IPFS_GATEWAYS=["https://cdn.kleros.link/ipfs/","https://ipfs.io/ipfs/","https://gateway.pinata.cloud/ipfs/"]

# KlerosCore proxy contract address on Arbitrum One.
# SANE DEFAULT: 0x991d2df165670b9cac3B022f4B68D65b664222ea
#CORE=0x991d2df165670b9cac3B022f4B68D65b664222ea

# PNK token contract address on Arbitrum One.
# SANE DEFAULT: 0x330bD769382cFc6d50175903434CCC8D206DCAE5
#PNK=0x330bD769382cFc6d50175903434CCC8D206DCAE5

# SortitionModule contract address on Arbitrum One.
# SANE DEFAULT: 0x21A9402aDb818744B296e1d1BE58C804118DC03D
#SORT=0x21A9402aDb818744B296e1d1BE58C804118DC03D

# DisputeResolver contract address on Arbitrum One.
# SANE DEFAULT: 0xb5526d022962a1fff6ed32c93e8b714c901f4323
#DISPUTERESOLVER=0xb5526d022962a1fff6ed32c93e8b714c901f4323

# DisputeTemplateRegistry contract address on Arbitrum One.
# SANE DEFAULT: 0x0cFBaCA5C72e7Ca5fFABE768E135654fB3F2a5A2
#DRT=0x0cFBaCA5C72e7Ca5fFABE768E135654fB3F2a5A2

# Chain name passed to `kleros evidence list --chain`.
# SANE DEFAULT: arbitrum-one
#EVIDENCE_CHAIN=arbitrum-one

# LLM harness to use for `skill generate`. Currently only "hermes" is implemented at runtime.
# SANE DEFAULT: hermes
#HARNESS=hermes  # optional; defaults to hermes
